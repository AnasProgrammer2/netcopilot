# Copy to fastlane/.env and fill in your values (never commit .env)

# Apple ID login (app-specific password from appleid.apple.com)
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team identifiers
APPLE_TEAM_ID=FC2U7NZKXV
# App Store Connect team ID (numeric — find it at appstoreconnect.apple.com under your account)
APP_STORE_CONNECT_TEAM_ID=

# App Store Connect API key (alternative to APPLE_ID + password — recommended for CI)
# Generate at: App Store Connect → Users & Access → Integrations → App Store Connect API
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Base64-encoded contents of the .p8 key file:  base64 -i AuthKey_XXXXXX.p8 | tr -d '\n'
APP_STORE_CONNECT_KEY_CONTENT=
